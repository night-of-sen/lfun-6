     * 配好后可在后台「分享回流 / 运维」里点「发送测试通知」验证。
     */
    'notify' => [
        'enabled' => false,
        'type'    => 'generic',
        'url'     => '',
        'secret'  => '',
        'on'      => ['claim' => true, 'paid' => false, 'donation' => true],
    ],
];
